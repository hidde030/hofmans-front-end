NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055 # Or your cloud instance URL
DIRECTUS_PUBLIC_TOKEN=your-public-token       # Token for public content (server-only)
DIRECTUS_FORM_TOKEN=your-form-token           # Token for form submissions (server-only, never exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # Application URL
DRAFT_MODE_SECRET=your-draft-mode-secret      # Secret for preview mode (server-only)
NEXT_PUBLIC_ENABLE_VISUAL_EDITING=true	 # Enable visual editing

# --- Form spam protection (optional, sensible defaults applied when unset) ---
# Secret used to sign the bot-protection challenge tokens. Falls back to
# DIRECTUS_FORM_TOKEN / DRAFT_MODE_SECRET when not set.
FORM_SECRET=your-form-secret
# Minimum time (ms) a visitor must spend on the page before submitting.
FORM_MIN_SUBMIT_MS=3000
# Maximum age (ms) of a challenge token before it expires.
FORM_MAX_SUBMIT_MS=3600000
# Maximum number of submissions allowed per IP within the window below.
FORM_RATE_LIMIT=5
FORM_RATE_LIMIT_WINDOW_MS=600000
# Hard cap on a single field's length to reject oversized junk.
FORM_MAX_FIELD_LENGTH=10000
